PORT=3000
POSTGRES_PORT=5546
LOCALSTACK_PORT=4567
DB_HOST=127.0.0.1
DB_PORT=5546
DB_USER=ballance
DB_PASSWORD=local-development-only
DB_NAME=ballance
TEST_SQS_ENDPOINT=http://127.0.0.1:4567

# Financial routes require both migrations and a restricted non-owner DB account.
FINANCIAL_API_ENABLED=false
AUTH_MODE=local-development
SQS_ENDPOINT=http://127.0.0.1:4567

# Start explicitly with bun run worker after configuring restricted DB runtime.
WORKER_MODE=all
WAGER_QUEUE_NAME=wager-transactions.fifo
WAGER_DLQ_NAME=wager-transactions-dlq.fifo
EVENT_QUEUE_NAME=wager-events.fifo
WORKER_METRICS_PORT=9101
DB_SCHEMA=public

# Compose application overlay: generate privately; minimum 16 characters.
# RUNTIME_DB_PASSWORD=
# HTTP_HOST defaults to 127.0.0.1 on host; Compose sets 0.0.0.0 inside container.
